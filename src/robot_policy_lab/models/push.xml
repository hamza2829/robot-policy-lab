<mujoco model="two_axis_push">
  <compiler angle="radian"/>
  <option timestep="0.0025" gravity="0 0 0" integrator="implicitfast"/>
  <default>
    <joint limited="true" damping="1"/>
    <geom friction="0.4 0.01 0.001" solref="0.005 1"/>
  </default>
  <worldbody>
    <geom name="table" type="plane" size="1 1 0.01" rgba="0.2 0.2 0.2 1"
          contype="0" conaffinity="0"/>
    <body name="x_carriage" pos="0 0 0.08">
      <joint name="arm_x" type="slide" axis="1 0 0" range="-0.45 0.45"/>
      <geom type="box" size="0.02 0.15 0.015" mass="0.2"
            contype="0" conaffinity="0" rgba="0.2 0.5 0.8 1"/>
      <body name="y_carriage">
        <joint name="arm_y" type="slide" axis="0 1 0" range="-0.3 0.3"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.055" size="0.012" mass="0.1"
              contype="0" conaffinity="0"/>
        <geom name="pusher" type="sphere" pos="0 0 -0.055" size="0.02" mass="0.1"
              rgba="0.1 0.6 0.9 1"/>
      </body>
    </body>
    <body name="block" pos="0 0 0.025">
      <joint name="block_x" type="slide" axis="1 0 0" range="-0.5 0.5" damping="1"/>
      <joint name="block_y" type="slide" axis="0 1 0" range="-0.35 0.35" damping="1"/>
      <geom name="block_geom" type="box" size="0.025 0.025 0.025" mass="0.08"
            rgba="0.9 0.4 0.2 1"/>
    </body>
    <site name="target" pos="0.25 0 0.025" size="0.025" rgba="0.2 0.9 0.3 0.4"/>
  </worldbody>
  <actuator>
    <velocity name="x_velocity" joint="arm_x" kv="40" ctrllimited="true"
              ctrlrange="-0.2 0.2" forcelimited="true" forcerange="-15 15"/>
    <velocity name="y_velocity" joint="arm_y" kv="40" ctrllimited="true"
              ctrlrange="-0.2 0.2" forcelimited="true" forcerange="-15 15"/>
  </actuator>
</mujoco>
